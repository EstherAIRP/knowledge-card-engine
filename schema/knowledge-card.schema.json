{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/EstherAIRP/knowledge-card-engine/schema/knowledge-card.schema.json",
  "title": "Knowledge Card Frontmatter",
  "description": "Structural schema for Knowledge Card YAML frontmatter. Controlled vocabulary membership is validated against the workspace taxonomy.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "title",
    "canonical_url",
    "source",
    "resource_kind",
    "created_at",
    "updated_at",
    "last_checked_at",
    "summary",
    "navigation",
    "classification",
    "relevance",
    "actions",
    "status"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "canonical_url": {
      "type": "string",
      "format": "uri"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "url",
        "identity"
      ],
      "properties": {
        "type": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "identity": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "resource_kind": {
      "$ref": "#/$defs/stringOwnership"
    },
    "created_at": {
      "type": "string",
      "format": "date"
    },
    "updated_at": {
      "type": "string",
      "format": "date"
    },
    "last_checked_at": {
      "type": "string",
      "format": "date"
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 600
    },
    "navigation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "categories"
      ],
      "properties": {
        "categories": {
          "$ref": "#/$defs/nonEmptyListOwnership"
        }
      }
    },
    "classification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "categories",
        "tags"
      ],
      "properties": {
        "categories": {
          "$ref": "#/$defs/nonEmptyListOwnership"
        },
        "tags": {
          "$ref": "#/$defs/listOwnership"
        }
      }
    },
    "relevance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ai",
        "user"
      ],
      "properties": {
        "ai": {
          "$ref": "#/$defs/relevanceMap"
        },
        "user": {
          "$ref": "#/$defs/partialRelevanceMap"
        }
      }
    },
    "actions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ai",
        "user"
      ],
      "properties": {
        "ai": {
          "$ref": "#/$defs/nonEmptyStringList"
        },
        "user": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/stringList"
            }
          ]
        }
      }
    },
    "status": {
      "$ref": "#/$defs/stringOwnership"
    }
  },
  "$defs": {
    "nonEmptyStringList": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "stringList": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "stringOwnership": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ai",
        "user"
      ],
      "properties": {
        "ai": {
          "type": "string",
          "minLength": 1
        },
        "user": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "minLength": 1
            }
          ]
        }
      }
    },
    "nonEmptyListOwnership": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ai",
        "user"
      ],
      "properties": {
        "ai": {
          "$ref": "#/$defs/nonEmptyStringList"
        },
        "user": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/nonEmptyStringList"
            }
          ]
        }
      }
    },
    "listOwnership": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ai",
        "user"
      ],
      "properties": {
        "ai": {
          "$ref": "#/$defs/stringList"
        },
        "user": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/stringList"
            }
          ]
        }
      }
    },
    "score": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5
    },
    "relevanceMap": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "$ref": "#/$defs/score"
      }
    },
    "partialRelevanceMap": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/score"
      }
    }
  }
}
