{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/EstherAIRP/knowledge-card-engine/schema/taxonomy.schema.json",
  "title": "Knowledge Card Taxonomy",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "categories",
    "navigation_categories",
    "relevance_dimensions",
    "relevance_scale",
    "actions",
    "statuses",
    "source_types",
    "resource_kinds"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "categories": {
      "$ref": "#/$defs/nonEmptyStringList"
    },
    "navigation_categories": {
      "$ref": "#/$defs/nonEmptyStringList"
    },
    "relevance_dimensions": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "label",
          "description"
        ],
        "properties": {
          "label": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "relevance_scale": {
      "type": "object",
      "minProperties": 5,
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "actions": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "statuses": {
      "$ref": "#/$defs/nonEmptyStringList"
    },
    "source_types": {
      "$ref": "#/$defs/nonEmptyStringList"
    },
    "resource_kinds": {
      "$ref": "#/$defs/nonEmptyStringList"
    }
  },
  "$defs": {
    "nonEmptyStringList": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
