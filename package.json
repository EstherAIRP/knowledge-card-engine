{
  "name": "@knowledge-card/engine",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "check": "node scripts/check-repository.mjs",
    "test": "node --test",
    "validate": "npm run check && npm test",
    "ui:verify": "node --test tests/web-ui-layout.test.mjs",
    "workspace:validate": "node scripts/validate-workspace.mjs",
    "cards:validate": "node scripts/validate-cards.mjs",
    "source-state:validate": "node scripts/validate-source-state.mjs",
    "research-state:validate": "node scripts/validate-research-state.mjs",
    "ingest:github": "node scripts/ingest-github.mjs",
    "site:serve": "node apps/server/src/node-server.js",
    "generated:build": "node scripts/release-workspace.mjs build",
    "release:finalize": "node scripts/release-workspace.mjs finalize",
    "release:validate": "node scripts/release-workspace.mjs validate",
    "ingest:github:handoff": "node scripts/ingest-github-handoff.mjs",
    "ingest:threads": "node scripts/ingest-threads.mjs",
    "ingest:handoff": "node scripts/ingest-handoff.mjs"
  }
}
